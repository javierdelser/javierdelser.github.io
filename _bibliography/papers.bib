@inproceedings{sarvanko2012spectrum,
  title = {{Spectrum Band and RAT Selection for Infrastructure Governed Opportunistic Networks}},
  author = {Sarvanko, Heli and Mustonen, Miia and Matinmikko, Marja and Hoytya, Marko and Del Ser, Javier},
  booktitle = {IEEE 17th International Workshop on Computer Aided Modeling and Design of Communication Links and Networks (CAMAD)},
