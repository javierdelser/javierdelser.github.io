@article{riano2026selfsupervised,
  title = {{A Self-Supervised Machine Learning Approach for the Estimation of Open-Circuit Voltage Degradation in Photovoltaic Systems}},
  author = {Sandra Riaño and Jose‐Domingo Santos and Miguel Esteras and Amaia Abanda and Del Ser, Javier},
  journal = {Progress in Photovoltaics Research and Applications},
  volume = {34},
  number = {7},
  pages = {920--941},
  year = {2026},
  doi = {10.1002/pip.70088},
  abbr = {Prog. Photovolt.},
  google_scholar_id = {SpPTWFSNUtQC},
  abstract = {In this work, we present a machine learning (ML) approach that integrates physics‐based knowledge with data‐driven techniques to estimate the open‐circuit voltage ( ) of photovoltaic (PV) systems. This self‐supervised approach allows the detection of anomalies in operating systems, enabling the identification of potential faults and degradation related to without requiring labelled data. Deviations in values are detected by analysing the measurements recorded in the supervisory control and data acquisition (SCADA) system. This analysis is performed by a combination of clustering and regression algorithms. The proposed approach is validated on three different PV installations, showcasing its ability to detect variations in open‐circuit voltage and to predict performance degradation. The proposed method achieves an ‐squared (r2) value larger than 0.9 when trained on experimental data from three distinct PV systems. Moreover, it estimates from SCADA data with an average error below 5% compared with – curve measurements. The results of this study demonstrate that physics informed ML techniques can significantly enhance the performance and reliability of PV systems, enabling early fault detection and degradation forecasting.},
  bibtex_show = {true},
}

@article{su2026self,
  title = {{Self-Supervised Cross-Sensor Spectral Image Fusion: A Cross-Domain Multimodal Reciprocal Learning Framework}},
  author = {Yuanchao Su and Jin Xu and Lianru Gao and Del Ser, Javier and Jiaxin Cheng and Yicong Zhou and Antonio Plaza and Bing Zhang and Guang Yang},
  journal = {IEEE Geoscience and Remote Sensing Magazine},
  pages = {2--25},
  year = {2026},
  doi = {10.1109/mgrs.2026.3729882},
  abbr = {IEEE GRSM},
  google_scholar_id = {rqnDXT1GswoC},
  abstract = {Spectral images provide richer information than RGB images, yet face a trade-off between spatial and spectral resolution: multispectral images (MSIs) offer high spatial details, whereas hyperspectral images (HSIs) capture fine spectral channels. Although spectral image fusion theoretically leverages the complementary strengths of HSIs and MSIs, existing methods often suffer from spectral distortion in the reconstructed HSI. This issue mainly arises because HSI and MSI sensors capture electromagnetic radiation differently, resulting in inconsistencies in the information distribution of the same scene. To alleviate these issues, this paper proposes a Cross-Domain Multimodal Reciprocal Learning (CMRL) framework for self-supervised spectral image fusion. CMRL enables self-supervised interactions across the frequency, spatial, and spectral domains via a contrastive learning strategy, maximizing the utilization of crucial information from each modality during multi-sensor spectral fusion. Furthermore, CMRL can leverage the global context-aware representations provided by vision Transformer (ViT) and vision Mamba (ViM) architectures to further explore the homogeneity between modalities. This design facilitates generalization across datasets acquired on different platforms. Based on this framework, we develop three variants: Independent CMRL (CMRL-I), ViT-based CMRL (CMRL-T), and ViM-based CMRL (CMRL-M). The code and new dataset are released at https://github.com/yuanchaosu/GRSM-CMRL},
  bibtex_show = {true},
}

@article{tamuly2026adaptive,
  title = {{Adaptive Conformalized RNN Ensembles for Uncertainty-Aware Motion Prediction of Floating Offshore Wind Turbines in Stochastic Marine Environments}},
  author = {Pranjal Tamuly and Del Ser, Javier and Hamed Fathnejat and Vincenzo Nava},
  journal = {Results in Engineering},
  pages = {114034},
  year = {2026},
  volume = {32},
  doi = {10.1016/j.rineng.2026.114034},
  abbr = {Results Eng.},
  google_scholar_id = {hefNtdE4IMkC},
  abstract = {Reliable motion prediction of Floating Offshore Wind Turbine (FOWT) platforms under stochastic metocean conditions is critical for structural safety, fatigue assessment, and operational control. Although Recurrent Neural Networks (RNNs) effectively capture temporal dynamics, their deterministic nature lacks uncertainty quantification, potentially leading to unforeseen failures, over-engineered designs, and increased maintenance costs. This study addresses this gap by introducing an Adaptive Conformalized RNN Ensembles (ACRNNE) framework that builds on conformal prediction and bootstrap-based RNN ensembles. The framework integrates three adaptive mechanisms: (1) an inverse-error weighting strategy that dynamically adjusts the contribution of each ensemble member at every prediction step, (2) a residual pool with weighted conformal inference and (3) an online update of the coverage level driven by the observed outcomes of earlier forecasts. Unlike conventional RNN models, the proposed method provides prediction intervals that adapt to the current metocean condition. The ACRNNE framework is thoroughly benchmarked against four established uncertainty-quantification techniques. ACRNNE achieves more consistent empirical coverage across the diverse metocean conditions than the evaluated baselines, with the largest gains for high, long-period waves. Furthermore, evaluation across multi-degree-of-freedom responses demonstrates robust performance with both LSTM and GRU architectures. Overall, ACRNNE enables uncertainty-aware motion prediction of FOWT platforms through empirically calibrated conformal intervals, supporting risk-informed decision-making in their operation and management.},
  bibtex_show = {true},
}

@article{uribe2026vamos,
  title = {{VAMOS: A Framework for Fast, Configurable and Accessible Multiobjective Optimization in Python}},
  author = {Nicolás R. Uribe and Alberto Herrán and Antonio Jesús Nebro and Del Ser, Javier and Jose Manuel Colmenar},
  journal = {Neurocomputing},
  pages = {135657},
  year = {2026},
  doi = {10.1016/j.neucom.2026.135657},
  abbr = {Neurocomputing},
  google_scholar_id = {j5aT6aphRxQC},
  abstract = {Python is widely used for empirical research in multi-objective optimization due to its accessibility and strong scientific ecosystem. However, most Python frameworks store populations as per-solution objects and keep critical computations in the interpreter, which prevents vectorization and significantly limits performance. This design gap makes Python-based metaheuristics much slower than their counterparts in compiled languages. In this paper we introduce VAMOS (Vectorized Architecture for Multiobjective Optimization Suite), a vectorized Python framework for multi-objective evolutionary algorithms (MOEAs). VAMOS maintains all population data in dense numerical arrays and dispatches hot-path operations to interchangeable numerical backends, decoupling algorithm logic from the underlying compute substrate. The framework implements eight MOEAs spanning dominance-based, decomposition-based, and indicator-based paradigms, and exposes rich component-level configurability, including interchangeable operators, external archives, and fine-grained parameter settings. VAMOS also integrates an automated algorithm-configuration module and provides a browser-based graphical interface to simplify use by non-experts. The results show that VAMOS achieves levels of solution quality statistically equivalent to those obtained by MOEAs implemented in state-of-the-art libraries, while reducing wall-clock time by large margins across all tested algorithms. These gains confirm that vectorized population models and backend-agnostic kernels at the core of VAMOS can deliver high performance in Python without compromising algorithmic behavior.},
  bibtex_show = {true},
}

@article{villatecastillo2026systematic,
  title = {{A Systematic Review of Toxicity in Large Language Models: Definitions, Datasets, Detectors, Detoxification Methods and Challenges}},
  author = {Guillermo Villate-Castillo and Del Ser, Javier and Borja Sanz},
  journal = {Artificial Intelligence Review},
  volume = {59},
  number = {11},
  year = {2026},
  pages = {240},
  doi = {10.1007/s10462-026-11548-z},
  abbr = {AI Review},
  google_scholar_id = {hNSvKAmkeYkC},
  abstract = {The emergence of the transformer architecture has ushered in a new era of possibilities, showcasing remarkable capabilities in generative tasks exemplified by models like GPT4o, Claude 3, and Llama 3. However, these advancements come with a caveat: predominantly trained on data gleaned from social media platforms, these systems inadvertently perpetuate societal biases and toxicity. Recognizing the paramount importance of AI Safety and Alignment, our study embarks on a thorough exploration through a comprehensive literature review focused on toxic language. Delving into various definitions, detection methodologies, and mitigation strategies, we aim to shed light on the complexities of this issue. Our study primarily focuses on transformer-based architectures, with deep learning methods serving as a crucial baseline for comparison in our exploration of toxic language detection and mitigation. Through our investigation, we uncover a multitude of challenges inherent in toxicity mitigation and detection models. These challenges range from inherent biases and generalization issues to the necessity for standardized definitions of toxic language and the quality assurance of dataset annotations. Furthermore, we emphasize the significance of transparent annotation processes, resolution of annotation disagreements, and the enhancement of Large Language Models (LLMs) robustness. Additionally, we advocate for the creation of standardized benchmarks to gauge the effectiveness of toxicity mitigation and detection methods. Addressing these challenges is not just imperative, but pivotal in advancing the development of safer and more ethically aligned AI systems.},
  bibtex_show = {true},
}

