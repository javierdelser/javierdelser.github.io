@article{tanveer2024fuzzy,
  title = {{Fuzzy Deep Learning for the Diagnosis of Alzheimer's Disease: Approaches and Challenges}},
  author = {M. Tanveer and M. Sajid and Mushir Akhtar and A. Quadir and Tripti Goel and A. Aimen and Sushmita Mitra and Yudong Zhang and Chin‐Teng Lin and Del Ser, Javier},
  journal = {IEEE Transactions on Fuzzy Systems},
