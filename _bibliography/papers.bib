  title = {{A Robust Cyberattack Detection Approach Using Optimal Features of SCADA Power Systems in Smart Grids}},
  author = {Gumaei, Abdu and Hassan, Mohammad Mehedi and Huda, Shamsul and Hassan, Md Rafiul and Camacho, David and Del Ser, Javier and Fortino, Giancarlo},
  journal = {Applied Soft Computing},
  volume = {96},
