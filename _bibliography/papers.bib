  author = {Santos, Marcus A. G. and Muñoz, Roberto and Olivares, Rodrigo and Reboucas Filho, Pedro P. and Del Ser, Javier and de Albuquerque, Victor Hugo C.},
  journal = {Information Fusion},
  volume = {53},
  pages = {222--239},
