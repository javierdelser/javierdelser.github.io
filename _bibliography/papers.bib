@article{sanchezmontero2012efficient,
  title = {{Efficient Design of a Double-Band Coplanar Hybrid Antenna Using Multi-Objective Evolutionary Programming}},
  author = {Sánchez-Montero, R. and López-Espí, P. and Manjarres, D. and Landa-Torres, I. and Salcedo-Sanz, S. and Del Ser, Javier},
  journal = {International Journal of Numerical Modelling: Electronic Networks, Devices and Fields},
