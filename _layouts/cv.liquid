---
layout: default
---
{% comment %}
  Local override of al_folio_core's cv layout. It renders the CV exactly as the theme does and adds two labelled
  PDF download buttons next to the page title:
    - "Summary CV": page.cv_pdf_summary (generated with bin/make_cv_pdf.py)
    - "Full CV":    page.cv_pdf_full    (generated with bin/make_full_cv_pdf.rb)
{% endcomment %}
{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  {% capture cv_html %}{% al_folio_cv_render %}{% endcapture %}
  {% capture cv_buttons %}
    <span class="cv-downloads">
      {% if page.cv_pdf_summary %}
        <a
          class="btn btn-sm cv-download"
          href="{{ page.cv_pdf_summary | relative_url }}"
          target="_blank"
          rel="noopener noreferrer"
          title="Short CV (PDF)"
        >
          <i class="fa-solid fa-file-pdf"></i> Summary CV
        </a>
      {% endif %}
      {% if page.cv_pdf_full %}
        <a
          class="btn btn-sm cv-download"
          href="{{ page.cv_pdf_full | relative_url }}"
          target="_blank"
          rel="noopener noreferrer"
          title="Complete CV with all the information on this website (PDF)"
        >
          <i class="fa-solid fa-file-pdf"></i> Full CV
        </a>
      {% endif %}
    </span>
    </h1>
  {% endcapture %}
  {{ cv_html | replace_first: '</h1>', cv_buttons }}
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
    <article>
      <p>Enable the <code>al_folio_cv</code> plugin and set <code>al_folio.features.cv.enabled: true</code> to render this page.</p>
    </article>
  </div>
{% endif %}

<style>
  .cv-downloads {
    float: right;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.35rem;
  }
  .cv-downloads .cv-download {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--global-theme-color);
    border: 1px solid var(--global-theme-color);
    border-radius: 0.3rem;
    padding: 0.25rem 0.7rem;
    background: transparent;
    box-shadow: none;
    text-transform: none;
  }
  .cv-downloads .cv-download:hover {
    color: var(--global-bg-color);
    background: var(--global-theme-color);
    text-decoration: none;
  }
</style>
